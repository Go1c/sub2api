# Dev server port (default 5174)
VITE_DEV_PORT=5174

# Backend base URL. Leave empty to use built-in mock adapter.
# Example: http://localhost:8080
VITE_API_BASE_URL=

# Set to "false" to turn off the mock axios interceptor even without a backend.
VITE_USE_MOCK=true

# Visible site name shown in the top bar.
VITE_SITE_NAME=LumioAPI

# Optional local/legacy fallback for DocsGPT support chat.
# Production should enable and configure it in the admin backend settings.
# The gateway URL is public; keys stay in support-gateway.
VITE_SUPPORT_CHAT_ENABLED=false
VITE_SUPPORT_CHAT_GATEWAY_URL=
