PORT=8080

# Internal or public DocsGPT API base URL, without a trailing slash.
DOCSGPT_API_BASE_URL=https://your-docsgpt-service

# DocsGPT Agent API key. Keep this only in the gateway service.
DOCSGPT_AGENT_API_KEY=your-docsgpt-agent-key

# Comma-separated browser origins allowed to call this gateway.
ALLOWED_ORIGINS=https://your-site.com,http://localhost:5174

SUPPORT_EMAIL=support@example.com
SUPPORT_URL=https://your-support-page.com

# Optional overrides. When omitted, /widget-config localizes defaults by ?locale.
WIDGET_TITLE=
WELCOME_MESSAGE=
OFFICIAL_CONTACT_TEXT=

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
